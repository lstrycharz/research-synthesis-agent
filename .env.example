# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Tavily (free tier: https://tavily.com)
TAVILY_API_KEY=tvly-...

# Langfuse (free cloud tier: https://cloud.langfuse.com)
# Optional: if these are unset, cost tracking still works locally; Langfuse tracing no-ops.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Model config (override in .env for testing with cheaper models)
SUPERVISOR_MODEL=claude-sonnet-4-6
WORKER_MODEL=claude-haiku-4-5-20251001
MAX_SUB_QUESTIONS=5
SEARCH_RESULTS_PER_QUERY=5
